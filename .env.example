# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="mysql://root:password@localhost:3306/starter_db"

# JWT (REQUIRED in production — app will not start without these)
JWT_ACCESS_SECRET=your-access-secret-change-me
JWT_REFRESH_SECRET=your-refresh-secret-change-me

# CORS (comma-separated origins, or * for all)
CORS_ORIGIN=*

# Docker MySQL
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=starter_db
